---
import DVNClaudeHero from './DVNClaudeHero.astro';
import DVNVideoTestimonials from './DVNVideoTestimonials.astro';
import DVNAuthenticitySection from './DVNAuthenticitySection.astro';
import SiteFooterLinks from './SiteFooterLinks.astro';
import faqEntries from '../data/dvnFaq.json';

export interface Props {
  canonicalURL: string;
  pageType: 'root' | 'path';
}

const { canonicalURL: _canonicalURL, pageType: _pageType } = Astro.props;

const whyItems = [
  ['DVN Tidak Dijual di Apotik', 'DVN dipasarkan eksklusif melalui jaringan dealer terverifikasi Wellous — bukan via apotik umum.'],
  ['Dapatkan dari Dealer Terdaftar', 'Kualitas terjaga, langsung dari sumber terpercaya.'],
  ['Konsultasi Gratis', 'Dealer menyediakan konsultasi via WhatsApp — tanpa biaya. Apotik tidak memberikan layanan ini.'],
  ['Traceability Lengkap', 'Setiap pembelian dari dealer DVN terverifikasi memiliki jejak transaksi yang tercatat, sehingga asal produk dapat ditelusuri.'],
  ['Bukan Kanal Marketplace', 'Wellous memasarkan DVN melalui jaringan dealer terdaftar. Keaslian produk yang dijual di Shopee, Tokopedia, Lazada, atau marketplace umum tidak dapat kami pastikan.'],
  ['Keaslian & Garansi Wellous', 'Pembelian via dealer terdaftar memastikan produk asli, dalam masa konsumsi optimal, dengan garansi penggantian dari Wellous.'],
];

// Single source for the visible FAQ and the FAQPage schema on the root page.
const faqs = faqEntries;

const waBase = '/api/wa';
const waLinks = {
  // The hero button (DVNClaudeHero) owns cta=hero_primary; this is the
  // consultation band further down, so it needs its own id.
  consultBand: `${waBase}?cta=consult_band&msg=${encodeURIComponent('Halo kak, saya ingin konsultasi tentang DVN Collagen')}`,
  promo: `${waBase}?cta=promo&msg=${encodeURIComponent('Halo kak, saya ingin cek ketersediaan dan promo DVN hari ini')}`,
  final: `${waBase}?cta=final_cta&msg=${encodeURIComponent('Halo kak, saya ingin memulai perjalanan kulit sehat bersama DVN')}`,
  floating: `${waBase}?cta=floating_wa&msg=${encodeURIComponent('Halo kak, saya ingin tanya tentang DVN Collagen')}`,
};
const deferredPixel = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1 1%22/%3E';
---

<style is:global>
  :root {
    --dvn-rose: #e5266d;
    --dvn-rose-dark: #b81555;
    --dvn-wine: #8e1746;
    --dvn-pink: #ff8fb7;
    --dvn-blush: #fff0f5;
    --dvn-blush-2: #fde1ec;
    --dvn-text: #533744;
    --dvn-muted: #75606a;
    --dvn-green: #19c969;
    --dvn-footer: #40253b;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    min-width: 320px;
    background: #fcebf1;
    color: var(--dvn-text);
    font-family: 'Plus Jakarta Sans', Arial, sans-serif;
  }
  .base-footer { display: none; }
  .dvn-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  button, a { -webkit-tap-highlight-color: transparent; }
  .dvn-ref-page {
    position: relative;
    width: min(100%, 724px);
    margin: 0 auto;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,248,251,.91), rgba(255,241,246,.93)),
      url('/images/dvn/reference2/page-background.webp') center top / 100% auto repeat-y;
    box-shadow: 0 0 42px rgba(139, 41, 78, .12);
  }
  .dvn-reference-body { position: relative; overflow: hidden; }
  .dvn-ref-page img { max-width: 100%; height: auto; }
  .dvn-serif {
    margin: 0;
    color: var(--dvn-rose);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 600;
    line-height: .96;
  }
  .dvn-section-heading { text-align: center; }
  .dvn-section-heading h2 { font-size: 30px; }
  .dvn-section-heading p {
    margin: 7px auto 0;
    color: #594551;
    font-size: 11px;
    line-height: 1.35;
  }
  .dvn-decor {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }
  .dvn-decor-flower-left { width: 110px; left: -40px; top: 92px; }
  .dvn-decor-flower-right { width: 105px; right: -28px; top: 5px; }
  .dvn-decor-petal-one { width: 40px; left: 55px; top: 16px; transform: rotate(-30deg); }
  .dvn-decor-petal-two { width: 36px; right: 128px; top: 65px; transform: rotate(20deg); }

  /* Hero, composed to mirror the 724px reference artwork. */
  .dvn-hero {
    position: relative;
    padding: 10px 46px 0;
    min-height: 350px;
  }
  .dvn-hero-kicker {
    position: relative;
    z-index: 2;
    margin: 0;
    text-align: center;
    color: #ee78a1;
    font-size: 11px;
    line-height: 1;
  }
  .dvn-hero-title {
    position: relative;
    z-index: 2;
    margin: 1px 0 0;
    text-align: center;
    font-size: 47px;
    font-style: italic;
    letter-spacing: -.02em;
  }
  .dvn-hero-subtitle {
    position: relative;
    z-index: 2;
    margin: 4px 0 10px;
    text-align: center;
    color: #5f4a55;
    font-size: 10.5px;
  }
  .dvn-hero-card {
    position: relative;
    z-index: 2;
    height: 262px;
    overflow: hidden;
    border: 1px solid rgba(222, 80, 134, .12);
    border-radius: 17px;
    background:
      radial-gradient(circle at 74% 20%, rgba(255,255,255,.96), transparent 30%),
      linear-gradient(112deg, rgba(255,255,255,.93), rgba(255,228,238,.78));
    box-shadow: 0 14px 34px rgba(185, 57, 104, .12);
  }
  .dvn-hero-copy {
    position: relative;
    z-index: 5;
    width: 44%;
    padding: 23px 0 0 28px;
  }
  .dvn-hero-copy h2 {
    font-size: 35px;
    line-height: .82;
  }
  .dvn-hero-copy h2 span { display: block; font-size: 22px; margin: 6px 0 8px; }
  .dvn-benefit-list { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .dvn-benefit-list li {
    display: grid;
    grid-template-columns: 19px 1fr;
    align-items: center;
    gap: 7px;
    font-size: 9.5px;
    font-weight: 600;
    line-height: 1.3;
  }
  .dvn-benefit-list li::before {
    content: '✓';
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(145deg, #ff8caf, #e92c72);
    color: #fff;
    font-size: 10px;
    box-shadow: 0 3px 7px rgba(219, 37, 101, .22);
  }
  .dvn-hero-trust {
    position: absolute;
    left: 28px;
    bottom: 12px;
    z-index: 7;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    width: 43%;
    margin: 0;
    font-size: 7.5px;
    font-weight: 700;
    color: #5d4651;
  }
  .dvn-hero-trust span { display: flex; min-width: 0; align-items: center; gap: 4px; }
  .dvn-hero-trust b {
    display: grid;
    width: 19px;
    height: 19px;
    place-items: center;
    border: 1.5px solid #9b486b;
    border-radius: 50%;
    color: var(--dvn-rose);
    font-size: 9px;
  }
  .dvn-hero-product {
    position: absolute;
    z-index: 5;
    left: 37%;
    bottom: 21px;
    width: 25%;
    aspect-ratio: 1.05;
    overflow: hidden;
    filter: drop-shadow(0 13px 12px rgba(154, 40, 80, .16));
  }
  .dvn-hero-product img {
    position: absolute;
    top: -137%;
    left: 0;
    width: 200%;
    max-width: none;
  }
  .dvn-hero-model {
    position: absolute;
    z-index: 4;
    right: -2px;
    top: 5px;
    width: 42%;
    filter: drop-shadow(-10px 8px 14px rgba(112, 45, 67, .12));
  }
  .dvn-superbrand {
    position: absolute;
    z-index: 6;
    right: 15px;
    bottom: 20px;
    width: 88px;
    filter: drop-shadow(0 4px 8px rgba(109, 62, 22, .18));
  }
  .dvn-handwritten {
    position: absolute;
    z-index: 6;
    left: 51%;
    top: 43px;
    width: 88px;
    color: #f05a92;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 17px;
    font-style: italic;
    font-weight: 600;
    line-height: 1.05;
    text-align: center;
    transform: rotate(-7deg);
  }

  .dvn-value-strip {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 10px 40px 11px;
  }
  .dvn-value-card {
    display: grid;
    min-height: 64px;
    grid-template-columns: 51px 1fr;
    align-items: center;
    gap: 5px;
    padding: 8px 9px;
    border: 1px solid rgba(226, 77, 131, .14);
    border-radius: 14px;
    background: rgba(255,255,255,.62);
    box-shadow: 0 5px 14px rgba(202, 77, 123, .05);
    font-size: 10px;
    line-height: 1.35;
  }
  .dvn-value-card img { width: 46px; height: 46px; object-fit: contain; }
  .dvn-value-card strong { color: var(--dvn-rose); }

  .dvn-consult {
    position: relative;
    display: grid;
    min-height: 134px;
    grid-template-columns: 190px 1fr 112px;
    align-items: center;
    overflow: hidden;
    padding: 0 38px;
    background:
      radial-gradient(circle at 50% 40%, rgba(255,255,255,.35), transparent 28%),
      linear-gradient(105deg, #f68aaa, #eb4b85 52%, #d91c68);
    color: #fff;
  }
  .dvn-consult-model {
    position: absolute;
    left: 58px;
    bottom: -96px;
    width: 180px;
    filter: drop-shadow(6px 8px 10px rgba(113, 23, 62, .2));
  }
  .dvn-consult-bubble {
    position: absolute;
    left: 28px;
    top: 21px;
    z-index: 3;
    width: 102px;
    padding: 11px 8px;
    border-radius: 49% 51% 48% 52%;
    background: #fff4f8;
    color: #c51c5d;
    font-size: 8px;
    font-weight: 700;
    text-align: center;
    transform: rotate(-8deg);
  }
  .dvn-consult-copy { grid-column: 2; position: relative; z-index: 4; text-align: center; }
  .dvn-consult-copy p { margin: 0 0 4px; font-size: 9px; }
  .dvn-consult-copy h2 { margin: 0 0 10px; color: #fff; font-size: 28px; font-style: italic; }
  .dvn-wa-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 23px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, #25dd79, #0cbc5e);
    box-shadow: 0 10px 20px rgba(0, 126, 60, .25), inset 0 1px rgba(255,255,255,.45);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .dvn-wa-button:hover { transform: translateY(-2px); box-shadow: 0 13px 24px rgba(0,126,60,.3); }
  .dvn-wa-button img { width: 20px; height: 20px; object-fit: contain; }
  .dvn-wa-button small { font-size: 16px; }
  .dvn-consult-note { margin: 6px 0 0 !important; font-size: 8px !important; }
  .dvn-consult-trust { grid-column: 3; display: grid; gap: 10px; position: relative; z-index: 3; font-size: 9px; font-weight: 600; }
  .dvn-consult-trust span { display: flex; align-items: center; gap: 7px; }
  .dvn-consult-trust img { width: 23px; height: 23px; flex: 0 0 23px; object-fit: contain; }

  .dvn-ingredients { position: relative; padding: 11px 38px 0; }
  .dvn-ingredients::after {
    content: '';
    position: absolute;
    right: -27px;
    top: 0;
    width: 120px;
    height: 130px;
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
    opacity: .66;
    pointer-events: none;
  }
  .dvn-ingredients.is-nearby::after { background-image: url('/images/dvn/reference2/decor/flowers-right.png'); }
  .dvn-ingredient-stage {
    position: relative;
    display: grid;
    height: 226px;
    grid-template-columns: 57% 43%;
    align-items: center;
    margin-top: 5px;
  }
  .dvn-ingredient-product {
    position: absolute;
    left: -8px;
    bottom: 6px;
    width: 58%;
    height: 210px;
    overflow: hidden;
    border-radius: 17px;
    background:
      radial-gradient(circle at 57% 36%, rgba(255,255,255,.94), transparent 34%),
      linear-gradient(155deg, rgba(255,244,248,.9), rgba(255,216,230,.5));
    filter: drop-shadow(0 12px 15px rgba(138, 50, 77, .1));
  }
  .dvn-product-plinth {
    position: absolute;
    z-index: 1;
    left: 5%;
    right: 4%;
    bottom: 9px;
    height: 35px;
    border-radius: 50%;
    background: linear-gradient(180deg, #f8edf0, #d7c5c6 70%, #bdadae);
    box-shadow: 0 10px 15px rgba(108,68,76,.15), inset 0 4px 8px rgba(255,255,255,.8);
  }
  .dvn-ingredient-pack {
    position: absolute;
    z-index: 4;
    left: 32%;
    bottom: 24px;
    width: 52%;
    aspect-ratio: 1.05;
    overflow: hidden;
    filter: drop-shadow(0 8px 8px rgba(122,57,79,.15));
  }
  .dvn-ingredient-pack img {
    position: absolute;
    top: -137%;
    left: 0;
    width: 200%;
    max-width: none;
  }
  .dvn-seven-item small { display: block; margin-top: 1px; color: #7a5a68; font-weight: 600; }
  .dvn-nowrap { white-space: nowrap; }
  .dvn-guarantee-list a { color: inherit; text-decoration: underline; }
  .dvn-stage-pomegranate {
    position: absolute;
    z-index: 3;
    left: 1%;
    bottom: 24px;
    width: 38%;
    filter: drop-shadow(0 7px 8px rgba(123,25,46,.15));
  }
  .dvn-stage-flowers {
    position: absolute;
    z-index: 5;
    left: -3%;
    bottom: 8px;
    width: 43%;
  }
  .dvn-stage-handwritten {
    position: absolute;
    z-index: 6;
    top: 24px;
    right: 5%;
    color: #eb6395;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 14px;
    font-style: italic;
    font-weight: 700;
    line-height: .9;
    text-align: center;
    transform: rotate(4deg);
  }
  .dvn-stage-handwritten small {
    display: block;
    margin-top: 4px;
    font-size: 8px;
    font-weight: 600;
  }
  .dvn-ingredient-panel {
    grid-column: 2;
    position: relative;
    z-index: 3;
    min-height: 188px;
    padding: 15px 13px 10px;
    border: 1px solid rgba(229, 59, 116, .12);
    border-radius: 15px;
    background: rgba(255,255,255,.84);
    box-shadow: 0 10px 24px rgba(169, 55, 95, .08);
  }
  .dvn-ingredient-panel h3 { margin: 0 0 5px; color: var(--dvn-rose-dark); font-family: Georgia, serif; font-size: 17px; }
  .dvn-ingredient-panel > p { margin: 0 0 8px; font-size: 9.5px; line-height: 1.35; }
  .dvn-seven-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px 4px; }
  .dvn-seven-item { color: var(--dvn-rose); font-size: 6.2px; font-weight: 700; line-height: 1.1; text-align: center; }
  .dvn-seven-item img { display: block; width: 41px; height: 41px; margin: 0 auto 3px; object-fit: contain; }
  .dvn-seven-item:nth-child(5) { grid-column: 1 / 2; }
  .dvn-seven-item:nth-child(7) { grid-column: 3 / 4; }
  .dvn-four-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding-bottom: 10px; }
  .dvn-ingredient-card {
    min-height: 125px;
    padding: 10px 8px 8px;
    border: 1px solid rgba(224, 78, 130, .15);
    border-radius: 15px;
    background: rgba(255,255,255,.58);
    text-align: center;
  }
  .dvn-ingredient-card img { width: 43px; height: 43px; object-fit: contain; }
  .dvn-ingredient-card h3 { margin: 3px 0 4px; color: var(--dvn-rose); font-family: Georgia, serif; font-size: 13px; }
  .dvn-ingredient-card .country {
    display: inline-block;
    margin-bottom: 5px;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(255,255,255,.88);
    box-shadow: 0 2px 7px rgba(156,74,101,.08);
    color: #5b4650;
    font-size: 8px;
    font-weight: 700;
  }
  .dvn-ingredient-card p { margin: 0; color: #65505b; font-size: 8px; line-height: 1.35; }

  .dvn-quote-card {
    display: grid;
    min-height: 91px;
    grid-template-columns: 35% 65%;
    align-items: center;
    margin: 0 38px 10px;
    overflow: hidden;
    border: 1px solid rgba(226, 78, 131, .13);
    border-radius: 15px;
    background: linear-gradient(90deg, rgba(255,255,255,.75), rgba(255,238,245,.88));
  }
  .dvn-coffee { font-size: 50px; text-align: center; filter: drop-shadow(0 6px 8px rgba(96,57,42,.15)); }
  .dvn-quote-copy { padding: 10px 18px 10px 0; text-align: center; }
  .dvn-quote-copy blockquote { margin: 0; color: var(--dvn-rose); font-family: Georgia, serif; font-size: 21px; font-style: italic; line-height: 1.05; }
  .dvn-quote-copy p { margin: 7px 0 0; font-size: 8.5px; }

  .dvn-quiz-teaser {
    display: grid;
    min-height: 80px;
    grid-template-columns: 70px 1fr 190px;
    align-items: center;
    gap: 8px;
    margin: 0 38px 12px;
    padding: 8px 15px;
    border: 1px solid rgba(226,78,131,.15);
    border-radius: 15px;
    background: rgba(255,255,255,.62);
    box-shadow: 0 8px 20px rgba(180,60,102,.06);
  }
  .dvn-quiz-teaser img { width: 55px; height: 55px; object-fit: contain; }
  .dvn-quiz-teaser h2 { margin: 0 0 3px; color: var(--dvn-rose); font-family: Georgia, serif; font-size: 16px; }
  .dvn-quiz-teaser p { margin: 0; font-size: 9px; line-height: 1.35; }
  .dvn-quiz-button {
    display: inline-flex;
    min-height: 39px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #ef4080, #df1665);
    box-shadow: 0 8px 17px rgba(197, 29, 93, .24);
    color: #fff;
    font: 700 11px 'Plus Jakarta Sans', sans-serif;
    cursor: pointer;
  }
  .dvn-quiz-button span { font-size: 17px; font-weight: 400; }
  .dvn-quiz-meta { display: block; margin-top: 4px; color: #6f5963; font-size: 6px; text-align: center; }

  .dvn-why { padding: 0 38px 9px; }
  .dvn-why .dvn-section-heading h2 { font-size: 23px; font-style: italic; }
  .dvn-why-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px 8px; margin-top: 9px; }
  .dvn-why-item {
    display: grid;
    min-height: 58px;
    grid-template-columns: 31px 1fr;
    gap: 8px;
    align-items: start;
    padding: 8px 10px;
    border: 1px solid rgba(225,78,129,.13);
    border-radius: 10px;
    background: rgba(255,255,255,.66);
  }
  .dvn-why-number {
    display: grid;
    width: 27px;
    height: 27px;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(145deg, #f66e9a, #df1b67);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 4px 9px rgba(216, 31, 99, .18);
  }
  .dvn-why-item h3 { margin: 0 0 2px; color: var(--dvn-rose); font-size: 10px; line-height: 1.2; }
  .dvn-why-item p { margin: 0; color: #69545e; font-size: 7.5px; line-height: 1.3; }

  .dvn-guarantee {
    margin: 0 31px 10px;
    padding: 10px 20px 13px;
    border: 1px solid rgba(226,78,131,.14);
    border-radius: 15px;
    background: rgba(255,255,255,.55);
  }
  .dvn-guarantee h2 {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    margin: 0 0 9px;
    color: #a22a5c;
    font-family: Georgia, serif;
    font-size: 19px;
  }
  .dvn-guarantee h2 img { width: 30px; height: 30px; object-fit: contain; }
  .dvn-guarantee-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .dvn-guarantee-list { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .dvn-guarantee-list li { position: relative; padding-left: 17px; font-size: 7.7px; line-height: 1.25; }
  .dvn-guarantee-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: -1px;
    display: grid;
    width: 12px;
    height: 12px;
    place-items: center;
    border-radius: 50%;
    background: #ff93b3;
    color: #fff;
    font-size: 7px;
  }

  .dvn-promo {
    position: relative;
    display: grid;
    min-height: 72px;
    grid-template-columns: 88px 1fr 205px;
    align-items: center;
    gap: 7px;
    margin: 0 37px 8px;
    padding: 7px 22px 7px 11px;
    border-radius: 14px;
    background: linear-gradient(105deg, #f23d7c, #d60e5f);
    box-shadow: 0 13px 26px rgba(185, 21, 86, .2);
