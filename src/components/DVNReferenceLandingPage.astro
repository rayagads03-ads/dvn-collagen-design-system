  <form class="dvn-quiz-form" method="dialog">
    <fieldset class="dvn-quiz-question"><legend>1. Kondisi kulit yang paling ingin kamu rawat?</legend><div class="dvn-quiz-options"><label><input type="radio" name="concern" value="kusam" /> Kulit kusam</label><label><input type="radio" name="concern" value="kering" /> Terasa kering</label><label><input type="radio" name="concern" value="garis" /> Garis halus</label><label><input type="radio" name="concern" value="semua" /> Semuanya</label></div></fieldset>
    <fieldset class="dvn-quiz-question"><legend>2. Rentang usia kamu?</legend><div class="dvn-quiz-options"><label><input type="radio" name="age" value="25-34" /> 25–34 tahun</label><label><input type="radio" name="age" value="35-44" /> 35–44 tahun</label><label><input type="radio" name="age" value="45-54" /> 45–54 tahun</label><label><input type="radio" name="age" value="55+" /> 55+ tahun</label></div></fieldset>
    <p class="dvn-quiz-summary" data-quiz-summary hidden></p>
    <a class="dvn-wa-button" data-quiz-result href={`${waBase}?cta=quiz_result&msg=${encodeURIComponent('Halo kak, saya sudah mengisi kuis kulit dan ingin rekomendasi personal DVN')}`} data-cta="quiz_result"><img src="/images/dvn/reference2/icons/whatsapp-64w.webp" alt="" width="64" height="62" loading="lazy" decoding="async" /> Kirim Jawaban ke Konsultan <small>→</small></a>
  </form>
</dialog>

<script>
  // GA4 via Cloudflare Zaraz. zaraz.track() is forwarded to GA4 by the tool's
  // Automatic Actions ("Events"). No-op when Zaraz is not enabled, and any
  // failure is swallowed so analytics can never break the page or WA links.
  const trackEvent = (name, properties = {}) => {
    try { window.zaraz?.track?.(name, properties); } catch {}
  };

  const quizDialog = document.querySelector('#dvn-skin-quiz');
  document.querySelectorAll('[data-quiz-open]').forEach((button) => {
    button.addEventListener('click', () => {
      if (quizDialog instanceof HTMLDialogElement && !quizDialog.open) {
        quizDialog.showModal();
        trackEvent('quiz_open', { quiz_source: button.closest('section')?.className.split(' ')[0] || 'unknown' });
      }
    });
  });

  // SXO-009: the answers go into the WhatsApp message so the consultant sees
  // them, and a short summary is shown above the button.
  const quizLabels = {
    concern: { kusam: 'kulit kusam', kering: 'kulit terasa kering', garis: 'garis halus', semua: 'beberapa keluhan kulit sekaligus' },
    age: { '25-34': '25–34 tahun', '35-44': '35–44 tahun', '45-54': '45–54 tahun', '55+': '55 tahun ke atas' },
  };
  const quizForm = quizDialog?.querySelector('form');
  const quizSummary = quizDialog?.querySelector('[data-quiz-summary]');
  const quizResultLink = quizDialog?.querySelector('[data-quiz-result]');
  const updateQuizResult = () => {
    if (!(quizForm instanceof HTMLFormElement) || !(quizResultLink instanceof HTMLAnchorElement)) return;
    const answers = new FormData(quizForm);
    const concern = quizLabels.concern[answers.get('concern')] || '';
    const age = quizLabels.age[answers.get('age')] || '';
    if (!concern && !age) return;
    const parts = [concern && `keluhan utama saya ${concern}`, age && `usia ${age}`].filter(Boolean);
    const message = `Halo kak, saya sudah mengisi kuis kulit: ${parts.join(', ')}. Mohon info DVN yang sesuai`;
    const url = new URL(quizResultLink.href, window.location.origin);
    url.searchParams.set('msg', message);
    quizResultLink.href = `${url.pathname}${url.search}`;
    if (quizSummary instanceof HTMLElement) {
      quizSummary.textContent = `Jawaban Anda: ${parts.join(' · ')}. Jawaban ini ikut terkirim ke konsultan di WhatsApp.`;
      quizSummary.hidden = false;
    }
  };
  quizForm?.addEventListener('change', (event) => {
    const input = event.target;
    if (input instanceof HTMLInputElement) trackEvent('quiz_answer', { question: input.name, answer: input.value });
    updateQuizResult();
  });
  document.querySelectorAll('[data-quiz-close]').forEach((button) => {
    button.addEventListener('click', () => {
      if (quizDialog instanceof HTMLDialogElement) quizDialog.close();
    });
  });
  if (quizDialog instanceof HTMLDialogElement) {
    quizDialog.addEventListener('click', (event) => {
      if (event.target === quizDialog) quizDialog.close();
    });
  }

  const initDeferredDecor = () => {
    const sections = Array.from(document.querySelectorAll('[data-defer-decor]'));
    if (!('IntersectionObserver' in window)) {
      sections.forEach((section) => section.classList.add('is-nearby'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-nearby');
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '350px 0px', threshold: 0 });
    sections.forEach((section) => observer.observe(section));
  };
  if (document.readyState === 'complete') initDeferredDecor();
  else window.addEventListener('load', initDeferredDecor, { once: true });

  const chatWidget = document.querySelector('[data-dvn-chat]');
  if (chatWidget instanceof HTMLElement && chatWidget.dataset.ready !== 'true') {
    chatWidget.dataset.ready = 'true';
    const panel = chatWidget.querySelector('[data-chat-panel]');
    const launcher = chatWidget.querySelector('[data-chat-launcher]');
    const close = chatWidget.querySelector('[data-chat-close]');
    const messagesBox = chatWidget.querySelector('[data-chat-messages]');
    const messages = Array.from(chatWidget.querySelectorAll('[data-chat-message]'));
    const typing = chatWidget.querySelector('[data-chat-typing]');
    const actions = chatWidget.querySelector('[data-chat-actions]');
    const badge = chatWidget.querySelector('[data-chat-badge]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let sequence = 0;
    let continuationPlayed = false;
    let introComplete = false;
    let scrollFrame = 0;

    const delay = (milliseconds) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));
    const scrollMessages = () => {
      if (!(messagesBox instanceof HTMLElement)) return;
      window.cancelAnimationFrame(scrollFrame);
      scrollFrame = window.requestAnimationFrame(() => {
        const targetScroll = messagesBox.scrollHeight;
        messagesBox.scrollTop = targetScroll;
      });
    };
    const setOpen = (open) => {
      chatWidget.classList.toggle('is-open', open);
      chatWidget.classList.toggle('is-bouncing', !open && introComplete);
      if (panel instanceof HTMLElement) {
        panel.toggleAttribute('inert', !open);
      }
      if (launcher instanceof HTMLButtonElement) launcher.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open && badge instanceof HTMLElement) badge.hidden = true;
    };
    const showMessage = (index) => {
      const message = messages[index];
      if (message instanceof HTMLElement) message.hidden = false;
      scrollMessages();
    };
    const showTyping = (show) => {
      if (typing instanceof HTMLElement) typing.hidden = !show;
      scrollMessages();
    };
    const typeThenReveal = async (index, token, duration = 900) => {
      showTyping(true);
      await delay(reducedMotion ? 120 : duration);
      if (token !== sequence) return false;
      showTyping(false);
      showMessage(index);
      return true;
    };
    const playContinuation = async () => {
      const token = ++sequence;
      messages.slice(0, 2).forEach((message) => {
        if (message instanceof HTMLElement) message.hidden = false;
      });
      introComplete = true;
      setOpen(true);
      scrollMessages();
      if (continuationPlayed) return;
      await delay(reducedMotion ? 120 : 420);
      if (!(await typeThenReveal(2, token, 1050))) return;
      await delay(reducedMotion ? 100 : 480);
      if (!(await typeThenReveal(3, token, 1150))) return;
      continuationPlayed = true;
      if (actions instanceof HTMLElement) actions.hidden = false;
      scrollMessages();
    };

    launcher?.addEventListener('click', () => {
      if (chatWidget.classList.contains('is-open')) {
        sequence += 1;
        showTyping(false);
        setOpen(false);
        return;
      }
      playContinuation();
      trackEvent('chat_open');
    });
    close?.addEventListener('click', () => {
      sequence += 1;
      showTyping(false);
      setOpen(false);
    });

    // Attention cue only: the panel never opens by itself (it used to open on
    // the first scroll and cover ~30% of a phone screen). It opens only when
    // the visitor taps the launcher.
    const showLauncherCue = () => {
      introComplete = true;
      chatWidget.classList.add('is-bouncing');
      if (badge instanceof HTMLElement) badge.hidden = false;
    };
    if (document.readyState === 'complete') showLauncherCue();
    else window.addEventListener('load', showLauncherCue, { once: true });
  }

  const query = new URLSearchParams(window.location.search);
  const attributionKeys = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  attributionKeys.forEach((key) => {
    const value = query.get(key);
    if (value) sessionStorage.setItem(`dvn_${key}`, value);
  });

  document.querySelectorAll('a[href^="/api/wa"]').forEach((link) => {
    if (!(link instanceof HTMLAnchorElement)) return;
    const url = new URL(link.href, window.location.origin);
    url.searchParams.set('from', window.location.pathname);
    attributionKeys.forEach((key) => {
      const value = query.get(key) || sessionStorage.getItem(`dvn_${key}`);
      if (value) url.searchParams.set(key, value);
    });
    link.href = `${url.pathname}${url.search}`;
    // Best effort: the page navigates to /api/wa immediately. The reliable
    // wa_click record (with ref code) is still the server-side GAS log.
    link.addEventListener('click', () => trackEvent('wa_click', { cta: link.dataset.cta || 'unknown' }));
  });

  document.querySelectorAll('.hero-jump-link').forEach((link) => {
    link.addEventListener('click', () => trackEvent('jump_nav_click', { target: link.getAttribute('href') || '' }));
  });
  document.querySelectorAll('.dvn-faq details').forEach((item) => {
    item.addEventListener('toggle', () => {
      if (item instanceof HTMLDetailsElement && item.open) trackEvent('faq_open', { question: item.querySelector('summary')?.textContent?.trim() || '' });
    });
  });
  document.querySelectorAll('a[href^="https://cekbpom.pom.go.id"], a[href^="https://www.wellous.com/"]').forEach((link) => {
    link.addEventListener('click', () => trackEvent('verification_link_click', { destination: new URL(link.href).hostname }));
  });
  // GA4 via Zaraz has no automatic scroll tracking.
  const scrollMarks = [50, 90];
  const reachedMarks = new Set();
  const checkScrollDepth = () => {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    if (scrollable <= 0) return;
    const percent = (window.scrollY / scrollable) * 100;
    scrollMarks.forEach((mark) => {
      if (percent >= mark && !reachedMarks.has(mark)) {
        reachedMarks.add(mark);
        trackEvent('scroll_depth', { percent: mark });
      }
    });
    if (reachedMarks.size === scrollMarks.length) window.removeEventListener('scroll', checkScrollDepth);
  };
  window.addEventListener('scroll', checkScrollDepth, { passive: true });

  const sendDeferredPageview = () => {
    const pageviewParams = new URLSearchParams({ event: 'page_view', landing_page: window.location.href });
    attributionKeys.forEach((key) => {
      const value = query.get(key) || sessionStorage.getItem(`dvn_${key}`);
      if (value) pageviewParams.set(key, value);
    });
    const pageview = new Image();
    pageview.src = `/api/track?${pageviewParams.toString()}`;
  };
  const schedulePageview = () => {
    window.setTimeout(() => {
      if ('requestIdleCallback' in window) window.requestIdleCallback(sendDeferredPageview, { timeout: 1800 });
      else sendDeferredPageview();
    }, 1200);
  };
  if (document.readyState === 'complete') schedulePageview();
  else window.addEventListener('load', schedulePageview, { once: true });
</script>
