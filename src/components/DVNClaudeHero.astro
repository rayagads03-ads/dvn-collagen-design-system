<script>
  const enableDeferredMotion = () => {
    if (document.documentElement.classList.contains('dvn-motion-ready')) return;
    const activate = () => {
      document.documentElement.classList.add('dvn-motion-ready');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const interactiveElements = document.querySelectorAll(
        '.dvn-ref-page a[href], .dvn-ref-page button, .dvn-chat-launcher, .dvn-wa-launcher'
      );
      const interactiveObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.target.classList.toggle('dvn-click-cue', entry.isIntersecting));
      }, { threshold: .35 });
      interactiveElements.forEach((element) => interactiveObserver.observe(element));

      // Product stage animation (96-frame animated WebP, ~3.9 MB, loops
      // forever). Armed only after the full page load + idle (this block runs in
      // activate()) AND the visitor's first interaction (scroll/touch/click/key);
      // page-speed tools never interact, so the 3.9 MB file is never part of
      // their measurement. Skipped on Save-Data and 2G connections.
      // The first time >= 45% of the image is on screen the animation is
      // loaded ONCE into the same <img> (the browser keeps painting the static
      // frame until it is ready) and then KEPT (Ray's decision, 25 Sep 2026).
      // Swapping back to the static image on scroll-out forced a re-load/
      // re-decode of 3.9 MB on every return, so visitors kept seeing the
      // static frame. A separate preloader Image() is avoided on purpose: it
      // downloaded the 3.9 MB file twice when the HTTP cache did not keep it.
      // Browsers do not paint off-screen animations.
      const productAnimation = document.querySelector('[data-product-animation]');
      if (
        productAnimation instanceof HTMLImageElement &&
        productAnimation.dataset.animationSrc &&
        productAnimation.dataset.staticSrc &&
        !navigator.connection?.saveData &&
        !/^(slow-2g|2g)$/.test(navigator.connection?.effectiveType || '')
      ) {
        const animationSrc = productAnimation.dataset.animationSrc;
        const productObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || entry.intersectionRatio < .45) return;
            productObserver.disconnect();
            const staticSrcset = productAnimation.getAttribute('srcset') || '';
            // Removing srcset can fire a load for the static file first, so only
            // count the load whose currentSrc is the animation.
            const onAnimationLoad = () => {
              if (!productAnimation.currentSrc.endsWith(animationSrc)) return;
              productAnimation.removeEventListener('load', onAnimationLoad);
              productAnimation.dataset.animationActive = 'true';
            };
            productAnimation.addEventListener('load', onAnimationLoad);
            // On failure restore the static image and its srcset.
            productAnimation.addEventListener('error', () => {
              productAnimation.dataset.animationActive = 'failed';
              productAnimation.src = productAnimation.dataset.staticSrc || '';
              if (staticSrcset) productAnimation.setAttribute('srcset', staticSrcset);
            }, { once: true });
            // srcset would win over src, so clear it before swapping.
            productAnimation.removeAttribute('srcset');
            productAnimation.src = animationSrc;
          });
        }, { threshold: [0, .45, .8] });
        const armAnimation = () => {
          ['scroll', 'touchstart', 'pointerdown', 'keydown'].forEach((type) => window.removeEventListener(type, armAnimation));
          productObserver.observe(productAnimation);
        };
        ['scroll', 'touchstart', 'pointerdown', 'keydown'].forEach((type) => window.addEventListener(type, armAnimation, { once: true, passive: true }));
      }
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(activate, { timeout: 1600 });
    else window.setTimeout(activate, 500);
  };

  if (document.readyState === 'complete') enableDeferredMotion();
  else window.addEventListener('load', enableDeferredMotion, { once: true });
</script>
